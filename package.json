{
  "name": "dsh-inbox-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a cross-project inbox for pending questions, deliverables, and interrupted turns.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "docs/panel.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "inbox",
    "sessions"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "external": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SophiaData/dsh-inbox.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/events.js && node --check lib/grouping.js && node --check lib/service.js && node --check lib/store.js && node --check lib/paths.js",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
